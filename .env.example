# Copy this file to ".env" and fill it in. Never share .env with anyone: it holds your secrets.

# Your Discord bot's token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
BOT_TOKEN=

# Your Reseller API key, made on the Reseller page of your Iancu Services dashboard.
# Start with a test key (isk_test_...): it never touches the real queue or your real credits.
# When everything works, replace it with a live key (isk_live_...).
API_KEY=

# The Reseller API address. Leave it as it is unless Iancu Services tells you otherwise.
API_BASE_URL=https://iancu.services/api/v1/reseller

# Your own Discord user id. This person is always a Super Administrator of the bot.
# (Discord -> Settings -> Advanced -> turn on Developer Mode, then right-click yourself -> Copy User ID.)
SUPER_ADMINISTRATOR=

# Your shop's name, shown in the footer of every message and in DMs to customers. "Shop" if empty.
SHOP_NAME=

# The colour of the bot's lists and information messages, as a hex colour without "#".
EMBED_COLOR=5865F2

# Where the bot keeps its own settings, staff, FAQ and status texts.
# The default is a file named bot.db next to package.json. For PostgreSQL, see the README.
DATABASE_URL="file:./bot.db"
